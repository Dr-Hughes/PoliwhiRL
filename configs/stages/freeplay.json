    "n_goals_target": 0,
    "ppo_entropy_anneal_enabled": false,
    "adaptive_entropy_enabled": false,
    "ppo_entropy_coef": 0.04,
    "ppo_lr_schedule": "constant",
    "ppo_learning_rate": 1e-4,
    "entropy_plateau_signal": "unique_maps",
    "intrinsic_reward_episode_cap": 0,
    "step_penalty": 0.0,
    "goals": []
}
