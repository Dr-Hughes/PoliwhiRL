{
    "extends": "../curriculum_base.json",
    "output_base_dir": "./Training Outputs/05b_freeplay/",
    "load_checkpoint": "./Training Outputs/05_mrpokemon/Checkpoints/best",
    "num_rollouts": 1000,
    "episode_length": 3072,
    "ppo_update_frequency": 256,
    "num_envs": 16,
    "terminate_on_goal_complete": false,
