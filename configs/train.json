{
    "output_base_dir": "./Training Outputs/train/",

    "num_rollouts": 2000,
    "episode_length": 2048,
    "ppo_update_frequency": 256,
    "num_envs": 16,
    "sequence_length": 8,
    "checkpoint_frequency": 50,

    "ppo_learning_rate": 3e-4,
    "ppo_gamma": "auto",
    "ppo_gae_lambda": 0.97,
    "ppo_epochs": 8,
    "ppo_epsilon": 0.2,
    "ppo_value_loss_coef": 1.0,
    "ppo_max_grad_norm": 0.5,
    "ppo_target_kl": 0.03,
    "ppo_clip_value_loss": true,
    "ppo_lr_schedule": "cosine",
    "ppo_lr_min": 5e-5,
    "ppo_minibatch_size": 128,

    "ppo_entropy_coef": 0.05,
    "ppo_entropy_coef_decay": 0.999,
    "ppo_entropy_coef_min": 0.01,
    "ppo_entropy_anneal_enabled": true,

    "entropy_plateau_reset": true,
    "entropy_plateau_signal": "unique_maps",
    "entropy_reset_window_fraction": 0.1,
    "entropy_reset_min_fraction": 0.1,
    "entropy_reset_debounce_fraction": 0.125,
    "entropy_reset_rewind_fraction": 0.1,
    "entropy_reset_max_count": 3,

    "advantage_normalisation": "rollout",
    "scaler_min_std": 1e-2,
    "best_success_window": 100,
    "best_success_min_episodes": 100,

    "archive_decay_rate": 0.97,
    "archive_decay_frequency": 100,
    "critic_warmup_rollouts": 2,
    "ram_recent_maps_n": 6,

    "early_stopping_enabled": false,
    "n_goals_target": 0,
    "goals": [],

    "new_map_reward": 50.0,
    "frontier_novelty_bonus": 25.0,
    "frontier_novelty_count_floor": 0,
    "whiteout_penalty": -20.0,
    "reward_clip": 1000,
    "reward_round_dp": 2,

    "action_mask_enabled": true
}
