{
    "sequence_length": 8,
    "ppo_learning_rate": 3e-4,
    "ppo_gamma": 0.99,

    "ppo_entropy_coef": 0.02,
    "ppo_entropy_coef_decay": 0.999,
    "ppo_entropy_coef_min": 0.005,
    "ppo_entropy_anneal_enabled": true,
    "adaptive_entropy_enabled": true,
    "adaptive_entropy_smoothing": 0.9,
    "entropy_plateau_reset": true,
    "entropy_plateau_signal": "goals",
    "entropy_reset_min_fraction": 0.1,
    "entropy_reset_window_fraction": 0.1,
    "entropy_reset_debounce_fraction": 0.125,
    "entropy_reset_rewind_fraction": 0.1,
    "entropy_reset_max_count": 3,
    "entropy_reset_solved_success_rate": 0.5,

    "ppo_lr_schedule": "cosine",
    "ppo_lr_min": 5e-5,
    "reset_lr_scheduler_on_load": true,
    "reset_optimizer_on_load": false,
    "reset_reward_scaler_on_load": true,
    "advantage_normalisation": "rollout",

    "extrinsic_reward_weight": 1.0,
    "intrinsic_reward_weight": 0.5,
    "scaler_min_std": 1e-2,
    "scaler_min_std_int": 0.1,

    "best_success_window": 100,
    "best_success_min_episodes": 100,
    "replay_hot_swap": false,
    "replay_pool_max": 64,
    "replay_capture_max_len": 0,

    "save_checkpoint": true,
    "checkpoint_frequency": 50,
    "record": true,
    "terminate_on_goal_complete": true,
    "early_stopping_enabled": true,
    "early_stopping_window": 100,
    "early_stopping_threshold": 0.6,
    "early_stopping_min_episodes": 50,

    "pokedex_owned_reward": 150,
    "pokedex_first_sight_reward": 10,
    "new_map_reward": 0,
    "new_map_first_discovery_reward": 50,
    "map_goal_reward": 250,
    "frontier_novelty_bonus": 10.0,
    "frontier_novelty_count_floor": 20,
    "intrinsic_reward_episode_cap": 0,
    "step_penalty": -0.02,
    "battle_engagement_reward": 3.0,
    "battle_win_reward": 8.0,
    "damage_dealt_reward": 0.0,
    "battle_reward_episode_cap": 30.0,
    "battle_decay_coef": 0.2,
    "level_up_reward": 10,
    "key_item_pickup_reward": 5,
    "whiteout_penalty": -100,
    "reward_round_dp": 2,
    "action_mask_enabled": true,
    "allow_menus_walking": false
}
